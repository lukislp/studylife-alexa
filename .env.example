ALEXA_SKILL_ID=amzn1.ask.skill.change-me

# Only ever false for local testing with a hand-crafted request body - never disable
# this in a deployed environment, or anyone who finds the URL can send it forged
# requests.
ALEXA_VERIFY_REQUESTS=true

# --- Account linking (oauth_provider.py) - all optional; only required once a
# StudyLife-backed intent needs a linked account. Leave unset for local Phase-A/B
# testing (LaunchRequest/TestIntent).

# This server's own public base URL (the Tailscale Funnel hostname).
ALEXA_PUBLIC_URL=https://studylife-alexa.example.ts.net

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Entered directly into the Alexa Developer Console's Account Linking config.
ALEXA_CLIENT_ID=change-me
ALEXA_CLIENT_SECRET=change-me

# Comma-separated - Alexa's Account Linking config page shows THREE fixed values once
# Client ID/Secret are filled in (one per regional companion app), not just one.
ALEXA_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/change-me,https://layla.amazon.com/api/skill/link/change-me,https://alexa.amazon.co.jp/api/skill/link/change-me

# StudyLife's own public base URL - used both for the browser-facing connect flow and
# (for now, no cluster-internal route configured for this repo) server-to-server API
# calls.
STUDYLIFE_CONNECT_URL=https://studylife.example.com
STUDYLIFE_BASE_URL=https://studylife.example.com

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALEXA_TOKEN_ENCRYPTION_KEY=change-me

ALEXA_OAUTH_DB_PATH=oauth.db
